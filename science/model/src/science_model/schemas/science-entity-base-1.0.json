{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science/science-entity-base-1.0.json",
  "title": "science entity base profile",
  "type": "object",
  "required": [
    "schema_profile",
    "id",
    "kind",
    "title",
    "version",
    "created",
    "updated"
  ],
  "properties": {
    "schema_profile": {
      "type": "string",
      "pattern": "^science-entity-base/[0-9]+\\.[0-9]+(\\+[a-z][a-z0-9._-]*/[0-9]+\\.[0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^(dataset|paper|topic|theme):[A-Za-z0-9][A-Za-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": ["dataset", "paper", "topic", "theme"]
    },
    "title": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "science:merge": "forbidden"
    },
    "description": {"type": "string"},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "licenses": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "path": {"type": "string"},
              "title": {"type": "string"}
            }
          }
        ]
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "email": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "ontology_terms": {"type": "array", "items": {"type": "string"}, "science:merge": "append"},
    "same_as": {"type": "array", "items": {"type": "string"}, "science:merge": "append"},
    "tags": {"type": "array", "items": {"type": "string"}, "science:merge": "append"},
    "dataset_usage": {"$ref": "#/$defs/dataset_usage", "science:merge": "append"},
    "status": {"type": "string"}
  },
  "$defs": {
    "dataset_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "role"],
        "properties": {
          "ref": {"type": "string", "pattern": "^dataset:"},
          "role": {"enum": ["analyzed", "set_definition_source", "validation_source", "cited", "upstream", "training", "reference"]},
          "overlap": {"enum": ["full", "partial", "unknown"]}
        }
      }
    }
  }
}
